# Test environment (Playwright)
#
# The Playwright webServer receives these values from `webServer.env` in
# playwright.config.ts, so this file is documentation only — Next.js does not
# load `.env.test` while running `next dev` (NODE_ENV=development).
#
# Copy to `.env.test` if you want to run the dev server with the same settings:
#   EMAIL_TRANSPORT=sink node --env-file=.env.test ... (or export the vars manually)

# smtp | sink | disabled
#   smtp     - deliver through each farmer's own SMTP server, configured in
#              Farmer Settings (production behaviour)
#   sink     - append messages as JSON lines to EMAIL_SINK_FILE instead of sending
#   disabled - drop every message
EMAIL_TRANSPORT=sink

# Where the sink writes captured messages. Tests read this file to assert on
# email content, and global setup/teardown delete it.
EMAIL_SINK_FILE=.tmp/test-emails.jsonl

# Key used to encrypt farmer SMTP credentials at rest (AES-256-GCM).
# playwright.config.ts already sets a test-only key for the webServer; this
# example mirrors it. NEVER reuse this value outside tests:
#   EMAIL_ENCRYPTION_KEY=Y2FiYXplcy10ZXN0LWVtYWlsLWtleWNhYmF6ZXMtdGU=
# In any real environment generate your own:
#   openssl rand -base64 32

# To inspect real SMTP traffic locally, run a mail catcher (Mailpit / MailHog /
# smtp4dev) and configure each farmer's email server in Farmer Settings to point
# at it, with EMAIL_TRANSPORT=smtp:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
