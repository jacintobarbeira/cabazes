generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  phone             String?
  passwordHash      String?
  role              Role      @default(CUSTOMER)
  timezone          String    @default("UTC")
  address           String?
  city              String?
  postalCode        String?
  notes             String?
  disabled          Boolean   @default(false)
  mustResetPassword Boolean   @default(false)
  senderEmail       String?
  managedById       String?
  managedBy         User?     @relation("FarmerHelpers", fields: [managedById], references: [id])
  helpers           User[]    @relation("FarmerHelpers")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orders            Order[]
  inviteTokens      InviteToken[]
  accounts          Account[]
  sessions          Session[]
  baskets           Basket[]         @relation("FarmerBaskets")
  products          Product[]        @relation("FarmerProducts")
  customerFarmers   CustomerFarmer[] @relation("CustomerFarmers")
  farmerCustomers   CustomerFarmer[] @relation("FarmerCustomers")
  deliveryPoints    DeliveryPoint[]  @relation("FarmerDeliveryPoints")
}

model Product {
  id          String    @id @default(cuid())
  farmerId    String
  farmer      User      @relation("FarmerProducts", fields: [farmerId], references: [id])
  name        String
  description String?
  category    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  basketItems BasketItem[]

  @@unique([name, farmerId])
  @@index([farmerId])
}

model Basket {
  id            String    @id @default(cuid())
  farmerId      String
  farmer        User      @relation("FarmerBaskets", fields: [farmerId], references: [id])
  name          String
  description   String?
  orderDeadline DateTime
  price         Decimal
  deliveryDay   DateTime
  allowedSwaps  Int       @default(3)
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         BasketItem[]
  orders        Order[]
  inviteTokens  InviteToken[]
  deliveryPoints BasketDeliveryPoint[]

  @@unique([name, deliveryDay, farmerId])
  @@index([farmerId])
}

model DeliveryPoint {
  id         String    @id @default(cuid())
  farmerId   String
  farmer     User      @relation("FarmerDeliveryPoints", fields: [farmerId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String?
  postalCode String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  baskets    BasketDeliveryPoint[]
  orders     Order[]

  @@unique([name, farmerId])
  @@index([farmerId])
}

model BasketDeliveryPoint {
  id              String        @id @default(cuid())
  basketId        String
  basket          Basket        @relation(fields: [basketId], references: [id], onDelete: Cascade)
  deliveryPointId String
  deliveryPoint   DeliveryPoint @relation(fields: [deliveryPointId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([basketId, deliveryPointId])
  @@index([basketId])
  @@index([deliveryPointId])
}

model BasketItem {
  id           String            @id @default(cuid())
  basketId     String
  basket       Basket            @relation(fields: [basketId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  isBase       Boolean           @default(true)
  baseChoices  OrderSwapChoice[] @relation("SwapChoicesBase")
  swapChoices  OrderSwapChoice[] @relation("SwapChoicesSwap")

  @@index([basketId])
  @@index([productId])
}

model Order {
  id                 String    @id @default(cuid())
  customerId         String
  customer           User      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  basketId           String
  basket             Basket    @relation(fields: [basketId], references: [id], onDelete: Restrict)
  inviteTokenId      String?   @unique
  inviteToken        InviteToken? @relation(fields: [inviteTokenId], references: [id], onDelete: SetNull)
  status             OrderStatus @default(PENDING)
  deliveryAddress    String
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryNotes      String?
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  swapChoices        OrderSwapChoice[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deliveryPointId    String?
  deliveryPoint      DeliveryPoint? @relation(fields: [deliveryPointId], references: [id], onDelete: SetNull)

  @@unique([customerId, basketId])
  @@index([basketId])
  @@index([status])
}

model OrderSwapChoice {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  baseItemId  String
  baseItem    BasketItem @relation("SwapChoicesBase", fields: [baseItemId], references: [id])
  swapItemId  String
  swapItem    BasketItem @relation("SwapChoicesSwap", fields: [swapItemId], references: [id])

  @@index([orderId])
}

model InviteToken {
  id            String    @id @default(cuid())
  customerId    String
  customer      User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  basketId      String
  basket        Basket    @relation(fields: [basketId], references: [id], onDelete: Cascade)
  token         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  orders        Order[]

  @@unique([basketId, customerId])
}

model CustomerFarmer {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation("CustomerFarmers", fields: [customerId], references: [id], onDelete: Cascade)
  farmerId   String
  farmer     User     @relation("FarmerCustomers", fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, farmerId])
  @@index([customerId])
  @@index([farmerId])
}

model AuthThrottle {
  id          String    @id @default(cuid())
  scope       String
  key         String
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([scope, key])
  @@index([key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

enum Role {
  FARMER
  FARMER_HELPER
  ADMINISTRATOR
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}
